{
  "name": "expo-audio-cache",
  "version": "1.0.1",
  "description": "Persistent offline download and cache layer for expo-audio",
  "author": "manchoudhary",
  "license": "MIT",
  "homepage": "https://github.com/manchoudhary/expo-audio-cache#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manchoudhary/expo-audio-cache.git"
  },
  "bugs": {
    "url": "https://github.com/manchoudhary/expo-audio-cache/issues"
  },
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "bob build",
    "prepublishOnly": "yarn test && yarn build",
    "pack:check": "yarn build && npm pack --dry-run",
    "example": "yarn --cwd example"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-audio",
    "expo-file-system",
    "cache",
    "offline",
    "audio-player",
    "download",
    "audio",
    "resumable"
  ],
  "peerDependencies": {
    "expo-file-system": ">=18.0.0",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.0",
    "expo-file-system": "~18.1.11",
    "jest": "^29.7.0",
    "react": "19.0.0",
    "react-native": "0.79.0",
    "react-native-builder-bob": "^0.40.13",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
